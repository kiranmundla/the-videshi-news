{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "the-videshi.vercel.app" }],
      "destination": "https://www.thevideshi.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap.xml" },
    { "source": "/rss.xml", "destination": "/api/rss.xml" },
    { "source": "/api/og", "destination": "/api/og" },
    { "source": "/api/subscribe", "destination": "/api/subscribe" },
    { "source": "/api/instagram-thumb", "destination": "/api/instagram-thumb" },
    { "source": "/api/verify-turnstile", "destination": "/api/verify-turnstile" },
    {
      "source": "/articles/:slug",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(Googlebot|bingbot|Baiduspider|YandexBot|DuckDuckBot|Slurp|facebookexternalhit|Twitterbot|LinkedInBot|Applebot|Discordbot|TelegramBot|WhatsApp).*" }],
      "destination": "/api/prerender?slug=:slug"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
